## removing outliers
fit.model<-lm(Y~X1+X2+X3+X4+X5+X6,REAL.ESTATE.DATA)
t=4/nrow(REAL.ESTATE.DATA)
cooks_distance <- cooks.distance(fit.model)
outliers<-which(cooks_distance>t)
REAL_ESTATE<-REAL.ESTATE.DATA[-c(outliers),]





## PLOTS AND TEST FOR MULTICOLINEARITY


library(corrplot)
corr<-cor(REAL_ESTATE[2:8])
corrplot(corr)
library(car)
plot(REAL_ESTATE)
library(DataExplorer)
plot_correlation(REAL_ESTATE[2:8])
ols_coll_diag(fit.model)




## VIF values

vif(fit.model)



## model step
fit.model1<-lm(Y~X1+X2+X3+X4+X5+X6,REAL_ESTATE)
ols_regress(fit.model1)
ols_eigen_cindex(fit.model1)



## checking for assumption of regression

## linearity

ols_plot_resid_fit(fit.model1)
ols_plot_resid_hist(fit.model1)


## normality 

ols_plot_resid_qq(fit.model1)



shapiro.test(fit.model1$residuals)




## constant variances

ols_test_breusch_pagan(fit.model1)


  
  ## Residual box plot
  
  ols_plot_resid_box(fit.model1)





## FINAL MODEL SELECTION 

library(MASS)
step.model<-step(fit.model1, direction="both", trace=T)
step.model
ols_step_both_aic(fit.model1)
K=ols_step_best_subset(fit.model1)
ols_regress(step.model)
summary(step.model)



## check all assumptions for final model

final.model<-lm(Y~ X1 + X2 + X3 + X4 + X5, data = REAL_ESTATE)
ols_plot_resid_fit(final.model)
ols_plot_resid_qq(final.model)
shapiro.test(final.model$residuals)
ols_plot_resid_hist(final.model)
ols_test_breusch_pagan(final.model)
ols_coll_diag(final.model)
vif(final.model)
ols_vif_tol(final.model)












